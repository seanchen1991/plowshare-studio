{
	"extends": "@tsconfig/svelte/tsconfig.json",
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022", "dom", "dom.iterable", "webworker"],
		"types": ["node"],
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"allowJs": true,
		"checkJs": true,
		"isolatedModules": true
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "tests/**/*.ts", "*.config.ts", "svelte.config.js"]
}
